PORT=3000

SA_PASSWORD=senha_do_sa_do_banco

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Deve ser uma string longa e aleatória.
JWT_SECRET=coloque_a_senha_do_jwt_aqui


# Tempo de expiração do token (formato do jsonwebtoken): '1h', '24h', '7d', '30d'
JWT_EXPIRES_IN=3h
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=email_padrao@gmail.com
SMTP_PASS=suaSenhaDe16Caracteres
MAIL_FROM="ProjetoZup <email_padrao@gmail.com>"
APP_NAME=ProjetoZup

# Frontend que vai receber o token na querystring
# URL do front e caminho do reset do frontend (usado para definir modelo do email)
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_PATH=/reset-password

# Token de reset
RESET_TOKEN_BYTES=32
RESET_TOKEN_EXPIRES_MINUTES=30

# Rate limit (testes: aumente os MAX; produção: diminua)
RATE_LIMITERS_ENABLED=true
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_RESET_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_RESET_PASSWORD_MAX=10

