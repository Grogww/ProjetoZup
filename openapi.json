{
  "openapi": "3.0.3",
  "info": {
    "title": "ProjetoZup API",
    "version": "1.0.0",
    "description": "API REST para gestão de infraestrutura urbana (categorias, subcategorias, bairros e ocorrências com geolocalização).",
    "license": { "name": "GPL-3.0" }
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "tags": [
    { "name": "Health", "description": "Verificação de saúde da API" },
    { "name": "Auth", "description": "Autenticação (registro, login, refresh de tokens JWT)" },
    { "name": "Users", "description": "Gerenciamento de usuários" },
    { "name": "Categories", "description": "Categorias de ocorrências" },
    { "name": "Subcategories", "description": "Subcategorias de ocorrências" },
    { "name": "Neighborhoods", "description": "Bairros" },
    { "name": "Occurrences", "description": "Registro e gestão de ocorrências urbanas" },
    { "name": "Evaluations", "description": "Avaliações de ocorrências (upvote/downvote)" },
    { "name": "Media", "description": "Anexos de mídia (fotos/vídeos) de ocorrências" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Servidor ativo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrar novo usuário",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterInput" },
              "example": {
                "name": "Eduardo Fritsch",
                "email": "eduardo@example.com",
                "password": "senhaSegura123",
                "neighborhood_id": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autenticar usuário e emitir tokens",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginInput" },
              "example": {
                "email": "eduardo@example.com",
                "password": "senhaSegura123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão criada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthSession" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Renovar tokens a partir do refresh token",
        "operationId": "refreshSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshInput" },
              "example": {
                "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens renovados",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthSession" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Solicitar redefinição de senha",
        "description": "Gera um token de redefinição e envia um e-mail com o link de recuperação. Por segurança, sempre retorna 200 com uma mensagem genérica, independentemente de o e-mail estar ou não cadastrado (evita enumeração de usuários). Endpoint sujeito a rate limit.",
        "operationId": "forgotPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgotPasswordInput" },
              "example": { "email": "eduardo@example.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mensagem genérica (token enviado por e-mail se o usuário existir)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "If this email is registered, password reset instructions have been sent."
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Redefinir senha com token",
        "description": "Recebe o token enviado por e-mail e a nova senha. O token é validado contra o hash armazenado e sua expiração. Endpoint sujeito a rate limit.",
        "operationId": "resetPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordInput" },
              "example": {
                "token": "a1b2c3d4e5f6...",
                "password": "novaSenhaSegura123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha atualizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Password updated successfully." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida ou token inválido/expirado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Visualizar perfil próprio (RF06)",
        "operationId": "getMyProfile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Perfil do usuário autenticado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Atualizar dados do próprio perfil (RF07)",
        "operationId": "updateMyProfile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserUpdateInput" },
              "example": {
                "name": "Eduardo F. Silva",
                "avatar_url": "https://cdn.example.com/avatars/eduardo.png"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil atualizado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Listar todos os usuários (RF08) — admin",
        "operationId": "listUsers",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Users"],
        "summary": "Consultar usuário por id (RF09) — admin",
        "operationId": "getUserById",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Usuário",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/users/{id}/role": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "patch": {
        "tags": ["Users"],
        "summary": "Alterar papel (role) de usuário (RF10) — admin",
        "operationId": "updateUserRole",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserRoleUpdateInput" },
              "example": { "role": "agent" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "Listar categorias",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "Lista de categorias",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "Criar categoria",
        "operationId": "createCategory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CategoryCreateInput" },
              "example": {
                "name": "Iluminação pública",
                "description": "Problemas relacionados à iluminação de vias e espaços públicos",
                "icon": "lightbulb",
                "color": "#FFC107",
                "is_active": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Categoria criada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Category" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/categories/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Categories"],
        "summary": "Obter categoria por id",
        "operationId": "getCategoryById",
        "responses": {
          "200": {
            "description": "Categoria",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Category" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Remover categoria",
        "operationId": "deleteCategory",
        "responses": {
          "204": { "description": "Removida" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/subcategories": {
      "get": {
        "tags": ["Subcategories"],
        "summary": "Listar subcategorias",
        "operationId": "listSubcategories",
        "responses": {
          "200": {
            "description": "Lista de subcategorias",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Subcategory" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Subcategories"],
        "summary": "Criar subcategoria",
        "operationId": "createSubcategory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubcategoryCreateInput" },
              "example": {
                "category_id": 1,
                "name": "Poste queimado",
                "description": "Poste de iluminação com lâmpada queimada",
                "icon": "bulb-off",
                "is_active": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subcategoria criada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Subcategory" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/subcategories/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Subcategories"],
        "summary": "Obter subcategoria por id",
        "operationId": "getSubcategoryById",
        "responses": {
          "200": {
            "description": "Subcategoria",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Subcategory" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Subcategories"],
        "summary": "Remover subcategoria",
        "operationId": "deleteSubcategory",
        "responses": {
          "204": { "description": "Removida" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/neighborhoods": {
      "get": {
        "tags": ["Neighborhoods"],
        "summary": "Listar bairros",
        "operationId": "listNeighborhoods",
        "responses": {
          "200": {
            "description": "Lista de bairros",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/NeighborhoodSummary" } }
              }
            }
          }
        }
      }
    },
    "/api/neighborhoods/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Neighborhoods"],
        "summary": "Obter bairro por id",
        "operationId": "getNeighborhoodById",
        "responses": {
          "200": {
            "description": "Bairro com geometria",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/NeighborhoodDetail" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/neighborhoods/{id}/occurrences": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Neighborhoods"],
        "summary": "Listar ocorrências de um bairro",
        "description": "Retorna todas as ocorrências do bairro informado, ordenadas por data de criação (mais recentes primeiro).",
        "operationId": "listNeighborhoodOccurrences",
        "responses": {
          "200": {
            "description": "Lista de ocorrências do bairro",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Occurrence" } } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/occurrences": {
      "get": {
        "tags": ["Occurrences"],
        "summary": "Listar ocorrências com filtros (RF12)",
        "operationId": "listOccurrences",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/OccurrenceStatus" }
          },
          { "name": "category_id", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "subcategory_id", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "neighborhood_id", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "author_id", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "assigned_organization_id", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 20 } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Lista de ocorrências",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Occurrence" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["Occurrences"],
        "summary": "Registrar ocorrência com geolocalização (RF11)",
        "operationId": "createOccurrence",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OccurrenceCreateInput" },
              "example": {
                "title": "Poste com lâmpada queimada",
                "description": "O poste em frente ao número 123 está sem iluminação há três dias.",
                "latitude": -29.6914,
                "longitude": -53.8008,
                "address": "Rua Exemplo, 123",
                "category_id": 1,
                "subcategory_id": 1,
                "neighborhood_id": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ocorrência criada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Occurrence" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Conflito — duplicata em 500m",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/OccurrenceDuplicateError" } }
            }
          }
        }
      }
    },
    "/api/occurrences/nearby": {
      "get": {
        "tags": ["Occurrences"],
        "summary": "Consultar ocorrências próximas — antiduplicidade 500m (RF16)",
        "operationId": "listNearbyOccurrences",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "format": "double", "minimum": -90, "maximum": 90 },
            "example": -29.6914
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "format": "double", "minimum": -180, "maximum": 180 },
            "example": -53.8008
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Raio em metros (default 500, máx 50000)",
            "schema": { "type": "number", "minimum": 1, "maximum": 50000, "default": 500 }
          }
        ],
        "responses": {
          "200": {
            "description": "Ocorrências dentro do raio, ordenadas por distância",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OccurrenceNearby" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/occurrences/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Occurrences"],
        "summary": "Visualizar detalhes de uma ocorrência (RF13)",
        "operationId": "getOccurrenceById",
        "responses": {
          "200": {
            "description": "Ocorrência",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Occurrence" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Occurrences"],
        "summary": "Remover ocorrência do sistema (RF15)",
        "operationId": "deleteOccurrence",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Removida" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/occurrences/{id}/status": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "patch": {
        "tags": ["Occurrences"],
        "summary": "Atualizar status de ocorrência (RF14)",
        "operationId": "updateOccurrenceStatus",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OccurrenceStatusUpdateInput" },
              "example": { "status": "in_progress" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ocorrência atualizada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Occurrence" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/occurrences/{id}/media": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Media"],
        "summary": "Listar mídias de uma ocorrência",
        "description": "Retorna todas as mídias anexadas à ocorrência, ordenadas por data de criação (mais antigas primeiro). Cada item traz a `url` servível dos bytes.",
        "operationId": "listOccurrenceMedia",
        "responses": {
          "200": {
            "description": "Lista de mídias da ocorrência",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OccurrenceMedia" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Media"],
        "summary": "Anexar foto/mídia a uma ocorrência (RF18)",
        "description": "Faz upload de 1..N arquivos (multipart/form-data, campo `media`) e os anexa à ocorrência. Os arquivos são validados por mimetype (allowlist) e tamanho máximo. O nome do arquivo no disco é gerado pelo servidor. Em caso de falha ao gravar no banco, os arquivos já salvos são removidos do disco.",
        "operationId": "addOccurrenceMedia",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["media"],
                "properties": {
                  "media": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" },
                    "description": "Um ou mais arquivos de mídia. Mimetypes permitidos (default): image/jpeg, image/png, image/webp, image/gif."
                  }
                }
              },
              "encoding": {
                "media": { "contentType": "image/jpeg, image/png, image/webp, image/gif" }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mídias anexadas",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/OccurrenceMedia" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": {
            "description": "Arquivo excede o tamanho máximo permitido",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "415": {
            "description": "Tipo de arquivo não suportado (fora da allowlist)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/occurrences/{id}/media/{mediaId}": {
      "parameters": [
        { "$ref": "#/components/parameters/IdPath" },
        {
          "name": "mediaId",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "minimum": 1 },
          "example": 1
        }
      ],
      "delete": {
        "tags": ["Media"],
        "summary": "Remover uma mídia de uma ocorrência",
        "description": "Remove o registro da mídia e o respectivo arquivo do disco. Retorna 404 se a mídia não existir ou não pertencer à ocorrência informada.",
        "operationId": "deleteOccurrenceMedia",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Mídia removida" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/occurrences/{id}/evaluations": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "get": {
        "tags": ["Evaluations"],
        "summary": "Listar avaliações de uma ocorrência",
        "operationId": "listOccurrenceEvaluations",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de avaliações (upvotes e downvotes), ordenadas por data de criação (mais recentes primeiro).",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Evaluation" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/occurrences/{id}/upvote": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "post": {
        "tags": ["Evaluations"],
        "summary": "Registrar upvote na ocorrência",
        "description": "Cria um upvote do usuário autenticado para a ocorrência. Se o usuário já tinha voto registrado (upvote ou downvote), o voto é atualizado. Ocorrências com status `closed` não aceitam votos.",
        "operationId": "upvoteOccurrence",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Avaliação criada ou atualizada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Evaluation" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Ocorrência fechada — votos não são permitidos",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/occurrences/{id}/downvote": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "post": {
        "tags": ["Evaluations"],
        "summary": "Registrar downvote na ocorrência",
        "description": "Cria um downvote do usuário autenticado para a ocorrência. Se o usuário já tinha voto registrado (upvote ou downvote), o voto é atualizado. Ocorrências com status `closed` não aceitam votos.",
        "operationId": "downvoteOccurrence",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Avaliação criada ou atualizada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Evaluation" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Ocorrência fechada — votos não são permitidos",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/occurrences/{id}/vote": {
      "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
      "delete": {
        "tags": ["Evaluations"],
        "summary": "Remover voto do usuário autenticado",
        "description": "Remove o voto (upvote ou downvote) do usuário autenticado para a ocorrência informada. Retorna 404 se o usuário não possuía voto registrado.",
        "operationId": "removeOccurrenceVote",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Voto removido" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido por /api/auth/login ou /api/auth/refresh. Use o header `Authorization: Bearer <access_token>`."
      }
    },
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 },
        "example": 1
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisição inválida",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Não autenticado ou token inválido/expirado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Usuário autenticado sem permissão para o recurso",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Recurso não encontrado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "Conflito de estado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "TooManyRequests": {
        "description": "Limite de requisições excedido (rate limit)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true, "nullable": true }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": ["citizen", "agent", "admin"],
        "description": "Papel do usuário no sistema"
      },
      "User": {
        "type": "object",
        "description": "Perfil público do usuário (campos sensíveis omitidos: password_hash, refresh_token, reset_token).",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "avatar_url": { "type": "string", "maxLength": 500, "nullable": true },
          "neighborhood_id": { "type": "integer", "nullable": true },
          "is_active": { "type": "boolean" },
          "email_verified_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "password": { "type": "string", "minLength": 8 },
          "neighborhood_id": { "type": "integer", "minimum": 1, "nullable": true }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "RefreshInput": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string" }
        }
      },
      "ForgotPasswordInput": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" }
        }
      },
      "ResetPasswordInput": {
        "type": "object",
        "required": ["token", "password"],
        "properties": {
          "token": { "type": "string", "description": "Token recebido por e-mail (parâmetro `token` da URL de redefinição)." },
          "password": { "type": "string", "minLength": 8, "description": "Nova senha (mínimo 8 caracteres)." }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": ["user", "access_token", "refresh_token", "token_type", "expires_in"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "access_token": { "type": "string", "description": "JWT de acesso. Enviar como `Authorization: Bearer <token>`." },
          "refresh_token": { "type": "string", "description": "JWT usado em /api/auth/refresh para emitir um novo access_token." },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "string", "description": "Duração do access_token (formato ms/zeit, ex.: '24h').", "example": "24h" }
        }
      },
      "UserUpdateInput": {
        "type": "object",
        "description": "Patch parcial do próprio perfil. Todos os campos são opcionais; apenas os enviados são alterados. Não permite alterar role, is_active ou refresh_token.",
        "properties": {
          "name": { "type": "string", "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "password": { "type": "string", "minLength": 8 },
          "avatar_url": { "type": "string", "maxLength": 500, "nullable": true },
          "neighborhood_id": { "type": "integer", "minimum": 1, "nullable": true }
        }
      },
      "UserRoleUpdateInput": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "$ref": "#/components/schemas/UserRole" }
        }
      },
      "OccurrenceDuplicateError": {
        "type": "object",
        "required": ["error", "details"],
        "properties": {
          "error": { "type": "string", "example": "A similar open occurrence already exists within 500m" },
          "details": {
            "type": "object",
            "properties": {
              "duplicate_id": { "type": "integer" },
              "distance_m": { "type": "number" }
            }
          }
        }
      },
      "GeoJSONPoint": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["Point"] },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" },
            "description": "[longitude, latitude]"
          }
        },
        "example": { "type": "Point", "coordinates": [-53.8008, -29.6914] }
      },
      "GeoJSONGeometry": {
        "type": "object",
        "description": "Qualquer geometria GeoJSON (Polygon, MultiPolygon, etc.)",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string" },
          "coordinates": {}
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "nullable": true },
          "icon": { "type": "string", "maxLength": 50, "nullable": true },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "nullable": true },
          "is_active": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CategoryCreateInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 100 },
          "description": { "type": "string" },
          "icon": { "type": "string", "maxLength": 50 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "is_active": { "type": "boolean", "default": true }
        }
      },
      "Subcategory": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "category_id": { "type": "integer" },
          "name": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "nullable": true },
          "icon": { "type": "string", "maxLength": 50, "nullable": true },
          "is_active": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "SubcategoryCreateInput": {
        "type": "object",
        "required": ["category_id", "name"],
        "properties": {
          "category_id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "maxLength": 100 },
          "description": { "type": "string" },
          "icon": { "type": "string", "maxLength": 50 },
          "is_active": { "type": "boolean", "default": true }
        }
      },
      "NeighborhoodSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "population_estimate": { "type": "integer", "nullable": true }
        }
      },
      "NeighborhoodDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/NeighborhoodSummary" },
          {
            "type": "object",
            "properties": {
              "boundary": { "$ref": "#/components/schemas/GeoJSONGeometry" },
              "center_point": { "$ref": "#/components/schemas/GeoJSONPoint" },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "OccurrenceStatus": {
        "type": "string",
        "enum": ["pending", "in_progress", "resolved", "rejected", "closed"]
      },
      "Occurrence": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string" },
          "location": { "$ref": "#/components/schemas/GeoJSONPoint" },
          "address": { "type": "string", "nullable": true },
          "category_id": { "type": "integer" },
          "subcategory_id": { "type": "integer", "nullable": true },
          "neighborhood_id": { "type": "integer", "nullable": true },
          "author_id": { "type": "integer" },
          "assigned_organization_id": { "type": "integer", "nullable": true },
          "status": { "$ref": "#/components/schemas/OccurrenceStatus" },
          "upvote_count": { "type": "integer" },
          "downvote_count": { "type": "integer" },
          "score": { "type": "integer" },
          "reopen_count": { "type": "integer" },
          "parent_occurrence_id": { "type": "integer", "nullable": true },
          "resolved_at": { "type": "string", "format": "date-time", "nullable": true },
          "closed_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "media": {
            "type": "array",
            "description": "Mídias anexadas à ocorrência. Presente apenas no detalhe (GET /api/occurrences/{id}).",
            "items": { "$ref": "#/components/schemas/OccurrenceMedia" }
          }
        }
      },
      "OccurrenceMedia": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "occurrence_id": { "type": "integer" },
          "url": {
            "type": "string",
            "description": "URL servível da mídia. Absoluta quando PUBLIC_BASE_URL está configurada; caso contrário relativa (ex.: /uploads/occurrences/<arquivo>).",
            "example": "/uploads/occurrences/a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4.jpg"
          },
          "storage_key": {
            "type": "string",
            "description": "Caminho relativo do arquivo dentro do diretório de uploads.",
            "example": "occurrences/a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4.jpg"
          },
          "original_name": { "type": "string", "nullable": true },
          "mime_type": { "type": "string", "example": "image/jpeg" },
          "size_bytes": { "type": "integer", "format": "int64" },
          "uploaded_by": { "type": "integer", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "OccurrenceNearby": {
        "allOf": [
          { "$ref": "#/components/schemas/Occurrence" },
          {
            "type": "object",
            "properties": {
              "distance_m": { "type": "number", "description": "Distância em metros do ponto consultado" }
            }
          }
        ]
      },
      "OccurrenceCreateInput": {
        "type": "object",
        "required": ["title", "description", "latitude", "longitude", "category_id"],
        "properties": {
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string" },
          "latitude": { "type": "number", "format": "double", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "format": "double", "minimum": -180, "maximum": 180 },
          "address": { "type": "string" },
          "category_id": { "type": "integer", "minimum": 1 },
          "subcategory_id": { "type": "integer", "minimum": 1, "nullable": true },
          "neighborhood_id": { "type": "integer", "minimum": 1, "nullable": true },
          "assigned_organization_id": { "type": "integer", "minimum": 1, "nullable": true },
          "parent_occurrence_id": { "type": "integer", "minimum": 1, "nullable": true },
          "status": { "$ref": "#/components/schemas/OccurrenceStatus" }
        }
      },
      "OccurrenceStatusUpdateInput": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/OccurrenceStatus" }
        }
      },
      "EvaluationVoteType": {
        "type": "string",
        "enum": ["up", "down"],
        "description": "Tipo do voto registrado pelo usuário em uma ocorrência."
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "occurrence_id": { "type": "integer" },
          "user_id": { "type": "integer" },
          "vote_type": { "$ref": "#/components/schemas/EvaluationVoteType" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
